{
  "version": 8,
  "name": "NavFrame TFT vector",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {"osm": {"type": "vector", "url": "https://tiles.openfreemap.org/planet", "attribution": "OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"}},
  "layers": [
    {"id":"background","type":"background","paint":{"background-color":"#0d1319"}},
    {"id":"water","type":"fill","source":"osm","source-layer":"water","paint":{"fill-color":"#142c40"}},
    {"id":"roads-minor","type":"line","source":"osm","source-layer":"transportation","filter":["in","class","minor","service","tertiary"],"paint":{"line-color":"#495563","line-width":["interpolate",["linear"],["zoom"],12,1,18,7]},"layout":{"line-cap":"round","line-join":"round"}},
    {"id":"roads-major","type":"line","source":"osm","source-layer":"transportation","filter":["in","class","primary","secondary","trunk","motorway"],"paint":{"line-color":"#b4c2ce","line-width":["interpolate",["linear"],["zoom"],10,1,18,10]},"layout":{"line-cap":"round","line-join":"round"}},
    {"id":"road-names","type":"symbol","source":"osm","source-layer":"transportation_name","minzoom":14,"filter":["in","class","primary","secondary","trunk","motorway"],"layout":{"symbol-placement":"line","text-field":"{name}","text-font":["Noto Sans Regular"],"text-size":16,"text-max-angle":30,"symbol-spacing":220},"paint":{"text-color":"#e5eef5","text-halo-color":"#0d1319","text-halo-width":2}}
  ]
}
